{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The ChurchFlow",
  "version": "0.19.0",
  "identifier": "com.joeystudios.churchflow",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4ODFDMDExMEU4MTM4QkMKUldTOE9JRU9FY0NCR0daWEVhMHl0UXNNc0s5Y2VLTi9jNFYyNEtOYWtoSFo4Y3VDSFErekNNVVoK",
      "endpoints": [
        "https://github.com/JoeyBlvck/church-app/releases/download/latest/latest.json"
      ]
    }
  }
}
