# Dependencies
node_modules/

# Local SQLite database (each environment has its own; never commit real church data)
*.db
*.db-journal
church.db

# OS cruft
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Local env / secrets
.env
.env.local

# Hikvision clock-in bridge config -- holds the device admin password and the bridge
# account's login; server/hikvision.config.example.json is the template that stays in git.
server/hikvision.config.json
server/.hikvision-state.json

# Hikvision bridge's macOS background-service file -- bakes in this machine's own absolute
# paths (node's install location, this checkout's own folder), so it's specific to whoever set
# it up here; server/com.churchflow.hikvision-bridge.plist.example is the template that stays
# in git. Its log files land next to it and are equally machine-specific.
server/com.churchflow.hikvision-bridge.plist
server/hikvision-bridge.log
server/hikvision-bridge.error.log

# Editor
.vscode/
.idea/

# Build output (Tauri desktop app, once scaffolded)
src-tauri/target/
dist/

# Desktop auto-update signing key -- lives in GitHub Actions secrets instead, never in git
# (see src-tauri/UPDATER_SIGNING_SECRETS.txt for what to do with it)
src-tauri/updater-signing-key.pem*
src-tauri/UPDATER_SIGNING_SECRETS.txt

# Offline edition: assembled by scripts/prepare-offline.mjs before building the installer
src-tauri/local-server/
